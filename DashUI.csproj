<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DashUI</AssemblyName>
    <RootNamespace>DashUI</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2025.3.31" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="AddUnityAndInteropRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <NuGetUnityDlls Include="$(NuGetPackageRoot)**/UnityEngine*.dll" />
      <NuGetInteropDlls Include="$(NuGetPackageRoot)**/Il2CppInterop*.dll" />
      <Reference Include="@(NuGetUnityDlls)" Condition="'@(NuGetUnityDlls)' != ''" />
      <Reference Include="@(NuGetInteropDlls)" Condition="'@(NuGetInteropDlls)' != ''" />
    </ItemGroup>
  </Target>
</Project>
